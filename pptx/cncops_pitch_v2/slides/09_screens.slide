  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'column', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', gap:24, height:478 }}>
      <Box style={{ width:760, justifyContent:'center', alignItems:'center', background:'rgba(255,255,255,0.03)', borderRadius:14, border:'1px solid rgba(255,255,255,0.08)', padding:10 }}>
        <Image src='assets/report_card.png' style={{ width:'100%', height:452, objectFit:'contain', borderRadius:8 }} />
      </Box>
      <Box style={{ flex:1, flexDirection:'column', gap:12, justifyContent:'center' }}>
        {[
          {n:'①', t:'左侧 · 报警置顶', d:'报警设备整条变红并自动置顶，3 台里哪台出问题一眼可见。'},
          {n:'②', t:'中间 · 口语输入', d:'"这台机器怎么了？说大白话就行"——一句话就能发起诊断。'},
