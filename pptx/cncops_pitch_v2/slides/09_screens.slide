        ].map((it, i) => (
          <Box key={i} style={{ flexDirection:'row', gap:12, alignItems:'flex-start', padding:'16px 16px', background: i === 2 ? 'rgba(34,211,238,0.10)' : 'rgba(255,255,255,0.04)', borderRadius:12, border: i === 2 ? '1px solid rgba(34,211,238,0.35)' : '1px solid rgba(255,255,255,0.08)' }}>
            <Text style={{ fontSize:24, color:'#22D3EE', fontWeight:'bold' }}>{it.n}</Text>
            <Box>
              <Text style={{ fontSize:17, color:'#E6EEF5', fontWeight:'bold' }}>{it.t}</Text>
              <Text style={{ fontSize:13.5, color:'#9FB6CC', lineHeight:1.5, marginTop:5 }}>{it.d}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:12, padding:'12px 20px', background:'rgba(46,92,138,0.20)', borderRadius:10, border:'1px solid rgba(46,92,138,0.55)' }}>
      <FAIcon name='check-circle' style={{ fill:'#22D3EE', width:22, height:22 }} />
      <Text style={{ fontSize:17, color:'#CDE6F5', lineHeight:1.5 }}>同一套响应式界面，<Text style={{ color:'#22D3EE', fontWeight:'bold' }}>车间平板 / 网页端通用</Text>；实测 30 台设备列表也不缩放、不变形。</Text>
