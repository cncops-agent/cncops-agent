<Slide style={{ width:'1280px', height:'720px', background:'#0F1B2D', padding:0, position:'relative' }}>
  <Box style={{ position:'absolute', top:0, left:0, right:0, height:6, background:'#22D3EE' }} />
  <Box style={{ position:'absolute', top:26, left:60, right:60, height:60, flexDirection:'row', alignItems:'center', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', alignItems:'baseline', gap:14 }}>
      <Text style={{ fontSize:13, color:'#22D3EE', fontWeight:'bold', letterSpacing:2 }}>PART 04</Text>
      <Text style={{ fontSize:30, color:'#E6EEF5', fontWeight:'bold' }}>经验沉淀闭环 · 记忆库</Text>
    </Box>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>MEMORY</Text>
  </Box>
  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'column', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', gap:26, height:470 }}>
      <Box style={{ width:600, justifyContent:'center', alignItems:'center', background:'rgba(255,255,255,0.03)', borderRadius:14, border:'1px solid rgba(255,255,255,0.08)', padding:10 }}>
        <Image src='assets/insights_stats.png' style={{ width:'100%', height:446, objectFit:'contain', borderRadius:8 }} />
      </Box>
      <Box style={{ flex:1, flexDirection:'column', justifyContent:'space-between', gap:12, paddingTop:6, paddingBottom:6 }}>
        <Text style={{ fontSize:22, color:'#E6EEF5', fontWeight:'bold', lineHeight:1.4 }}>把个人经验<Text style={{ color:'#22D3EE' }}>搬进系统</Text></Text>
        {[
          { t:'经验入库', d:'每次诊断与反馈自动落库，按"设备 + 报警码 + 超标测点"识别复发。' },
          { t:'复发预警', d:'同设备 30 天内同故障 ≥2 次标黄、≥3 次标红，提示禁止反复复位继续生产。' },
          { t:'停机台账', d:'按设备统计高频故障、平均处理时长、累计停机，可一键导出 Excel。' },
        ].map((it, i) => (
          <Box key={i} style={{ flexDirection:'row', gap:12, alignItems:'flex-start', padding:'10px 14px', background:'rgba(255,255,255,0.04)', borderRadius:10, border:'1px solid rgba(255,255,255,0.08)' }}>
            <FAIcon name='database' style={{ fill:'#22D3EE', width:20, height:20, marginTop:3 }} />
            <Box>
              <Text style={{ fontSize:17, color:'#E6EEF5', fontWeight:'bold' }}>{it.t}</Text>
              <Text style={{ fontSize:13, color:'#9FB6CC', lineHeight:1.4, marginTop:2 }}>{it.d}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:12, padding:'14px 20px', background:'rgba(34,211,238,0.10)', borderRadius:10, border:'1px solid rgba(34,211,238,0.35)' }}>
      <FAIcon name='chart-line' style={{ fill:'#22D3EE', width:24, height:24 }} />
      <Text style={{ fontSize:18, color:'#CDE6F5', lineHeight:1.5 }}>不仅诊断，还帮老板记账：<Text style={{ color:'#22D3EE', fontWeight:'bold' }}>设备复发自动报警，停机时长自动统计</Text>。</Text>
    </Box>
  </Box>
  <Box style={{ position:'absolute', bottom:0, left:0, right:0, height:44, flexDirection:'row', alignItems:'center', justifyContent:'space-between', paddingLeft:60, paddingRight:60, borderTop:'1px solid rgba(255,255,255,0.08)' }}>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>cncops-agent · 只读诊断</Text>
