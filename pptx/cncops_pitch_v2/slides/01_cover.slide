<Slide style={{ width:'1280px', height:'720px', background:'#0F1B2D', padding:0, position:'relative' }}>
  <svg style={{ position:'absolute', top:0, left:0 }} width='1280' height='720' viewBox='0 0 1280 720'>
    <defs>
      <pattern id='grid01' width='34' height='34' patternUnits='userSpaceOnUse'>
        <path d='M34 0 L0 0 0 34' fill='none' stroke='rgba(255,255,255,0.05)' strokeWidth='1'/>
      </pattern>
    </defs>
    <rect width='1280' height='720' fill='url(#grid01)'/>
  </svg>
  <Box style={{ position:'absolute', top:0, left:0, right:0, height:6, background:'#22D3EE' }} />
  <Box style={{ position:'absolute', top:36, left:60, flexDirection:'row', alignItems:'center', gap:14 }}>
    <Box style={{ padding:'7px 14px', borderRadius:6, background:'#22D3EE' }}>
      <Text style={{ fontSize:15, color:'#0F1B2D', fontWeight:'bold', letterSpacing:1 }}>单人成军</Text>
    </Box>
    <Text style={{ fontSize:15, color:'#9FB6CC', letterSpacing:2 }}>OPC 项目 · 车间设备智能诊断</Text>
  </Box>
  <Box style={{ position:'absolute', top:104, left:60, width:680, flexDirection:'column', gap:12 }}>
    <Text style={{ fontSize:18, color:'#CDE6F5', lineHeight:1.5 }}>面向中小加工厂的「设备医生」：把老师傅的经验，变成一线工人随时能调用的诊断能力。</Text>
    <Box style={{ flexDirection:'row', gap:10 }}>
      {['只读接入 · 绝不控设备','本地部署 · 断网可用','知识库溯源 · 步骤可查'].map((t, i) => (
        <Box key={i} style={{ padding:'8px 13px', borderRadius:20, background:'rgba(46,92,138,0.22)', border:'1px solid rgba(46,92,138,0.55)' }}>
          <Text style={{ fontSize:13, color:'#CDE6F5' }}>{t}</Text>
        </Box>
      ))}
    </Box>
    <Text style={{ fontSize:14, color:'#8FA3B8' }}>路演主线：需求背景 → 技术方案 → 应用流程 → 功能演示 → 落地案例</Text>
  </Box>
  <Box style={{ position:'absolute', top:36, right:60, flexDirection:'row', alignItems:'center', gap:10, padding:'8px 16px', border:'1px solid rgba(34,211,238,0.45)', borderRadius:30, background:'rgba(34,211,238,0.10)' }}>
    <FAIcon name='shield' style={{ fill:'#22D3EE', width:18, height:18 }} />
    <Text style={{ fontSize:14, color:'#22D3EE', fontWeight:'bold' }}>只读 · 不控设备</Text>
  </Box>
  <Text style={{ position:'absolute', top:238, left:60, fontSize:62, color:'#E6EEF5', fontWeight:'bold', lineHeight:1.1 }}>车间设备运维 AI 智能体</Text>
  <Text style={{ position:'absolute', top:330, left:60, fontSize:62, color:'#22D3EE', fontWeight:'bold', lineHeight:1.1 }}>只读诊断</Text>
  <Text style={{ position:'absolute', top:430, left:60, fontSize:22, color:'#9FB6CC', lineHeight:1.5 }}>说句大白话，2 秒拿到「该干什么、谁来干、怎么干才安全」</Text>
  <Box style={{ position:'absolute', top:486, left:60, padding:'9px 18px', borderRadius:30, background:'rgba(46,92,138,0.25)', border:'1px solid rgba(46,92,138,0.6)' }}>
    <Text style={{ fontSize:15, color:'#CDE6F5' }}>不写设备 · 安全可信 · 一线可用</Text>
  </Box>
  <Text style={{ position:'absolute', top:544, left:60, fontSize:15, color:'#8FA3B8' }}>单人成军 · 从需求洞察、架构设计到代码实现与交付验证，一人完成</Text>
  <Box style={{ position:'absolute', top:196, right:76, width:420, height:420, alignItems:'center', justifyContent:'center' }}>
    <Box style={{ position:'absolute', width:400, height:400, borderRadius:200, background:'rgba(34,211,238,0.06)', border:'2px solid rgba(34,211,238,0.22)' }} />
    <Box style={{ position:'absolute', width:306, height:306, borderRadius:153, background:'rgba(34,211,238,0.05)', border:'2px solid rgba(34,211,238,0.32)' }} />
    <Box style={{ position:'absolute', width:208, height:208, borderRadius:104, background:'rgba(34,211,238,0.10)', border:'2px solid rgba(34,211,238,0.45)' }} />
    <FAIcon name='shield' style={{ fill:'#22D3EE', width:132, height:132, opacity:0.95 }} />
  </Box>
  <Box style={{ position:'absolute', left:0, right:0, bottom:0, height:96, flexDirection:'row', borderTop:'1px solid rgba(255,255,255,0.10)' }}>
    <Box style={{ flex:1, alignItems:'center', justifyContent:'center', borderRight:'1px solid rgba(255,255,255,0.08)' }}>
      <Text style={{ fontSize:38, color:'#22D3EE', fontWeight:'bold' }}>11</Text>
      <Text style={{ fontSize:13, color:'#8FA3B8' }}>类可诊断故障</Text>
    </Box>
    <Box style={{ flex:1, alignItems:'center', justifyContent:'center', borderRight:'1px solid rgba(255,255,255,0.08)' }}>
      <Text style={{ fontSize:38, color:'#22D3EE', fontWeight:'bold' }}>3</Text>
      <Text style={{ fontSize:13, color:'#8FA3B8' }}>台联调设备</Text>
    </Box>
    <Box style={{ flex:1, alignItems:'center', justifyContent:'center', borderRight:'1px solid rgba(255,255,255,0.08)' }}>
      <Text style={{ fontSize:38, color:'#22D3EE', fontWeight:'bold' }}>12</Text>
      <Text style={{ fontSize:13, color:'#8FA3B8' }}>条知识库</Text>
    </Box>
    <Box style={{ flex:1, alignItems:'center', justifyContent:'center' }}>
      <Text style={{ fontSize:38, color:'#22D3EE', fontWeight:'bold' }}>82</Text>
      <Text style={{ fontSize:13, color:'#8FA3B8' }}>项自测通过</Text>
    </Box>
  </Box>
</Slide>
