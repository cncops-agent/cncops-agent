<Slide style={{ width:'1280px', height:'720px', background:'#0F1B2D', padding:0, position:'relative' }}>
  <Box style={{ position:'absolute', top:0, left:0, right:0, height:6, background:'#22D3EE' }} />
  <Box style={{ position:'absolute', top:26, left:60, right:60, height:60, flexDirection:'row', alignItems:'center', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', alignItems:'baseline', gap:14 }}>
      <Text style={{ fontSize:13, color:'#22D3EE', fontWeight:'bold', letterSpacing:2 }}>PART 05</Text>
      <Text style={{ fontSize:30, color:'#E6EEF5', fontWeight:'bold' }}>商业模式与路线图</Text>
    </Box>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>BUSINESS · ROADMAP</Text>
  </Box>
  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'column', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', gap:16 }}>
      {[
        {t:'免费版', p:'≤ 5 台', d:'10 秒看报警 + 基础诊断，留住一线操作工', tag:'获客入口', hot:false},
        {t:'专业版 · 主力', p:'¥6,800 / 年起', d:'自定义知识库、完整台账与导出、经验沉淀与复发提醒', tag:'续费核心：经验资产', hot:true},
        {t:'企业版', p:'私有化', d:'数据不出厂、私有化模型、多租户管理', tag:'大型 / 集团客户', hot:false},
      ].map((c, i) => (
        <Box key={i} style={{ flex:1, flexDirection:'column', padding:'18px 20px', background: c.hot ? 'rgba(34,211,238,0.10)' : 'rgba(255,255,255,0.04)', borderRadius:14, border: c.hot ? '2px solid #22D3EE' : '1px solid rgba(255,255,255,0.10)' }}>
          <Text style={{ fontSize:20, color: c.hot ? '#22D3EE' : '#E6EEF5', fontWeight:'bold' }}>{c.t}</Text>
          <Text style={{ fontSize:28, color: c.hot ? '#22D3EE' : '#E6EEF5', fontWeight:'bold', marginTop:6 }}>{c.p}</Text>
          <Text style={{ fontSize:14, color:'#9FB6CC', lineHeight:1.5, marginTop:8 }}>{c.d}</Text>
          <Text style={{ fontSize:13, color: c.hot ? '#22D3EE' : '#8FA3B8', marginTop:10, fontWeight:'bold' }}>{c.tag}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:12, padding:'12px 20px', background:'rgba(34,211,238,0.10)', borderRadius:10, border:'1px solid rgba(34,211,238,0.35)' }}>
      <FAIcon name='arrow-right' style={{ fill:'#22D3EE', width:20, height:20 }} />
      <Text style={{ fontSize:17, color:'#CDE6F5', lineHeight:1.5 }}>转化路径：<Text style={{ color:'#22D3EE', fontWeight:'bold' }}>免费版获客 → 专业版（¥6,800/年）沉淀经验 → 企业版私有化</Text></Text>
    </Box>
    <Box style={{ flexDirection:'column', gap:10 }}>
      <Text style={{ fontSize:18, color:'#22D3EE', fontWeight:'bold' }}>下一步：从仿真走向真实设备</Text>
      <Box style={{ flexDirection:'row', gap:12 }}>
        {[
          {n:'1', t:'只读网关试点', d:'接真机 OPC-UA 只读，1 条产线先跑起来'},
          {n:'2', t:'真实设备扩展', d:'接入真实注塑机、冲床、压铸等品类'},
          {n:'3', t:'生态（远期）', d:'配件工单、停机保险等数据服务'},
        ].map((r, i) => (
          <Box key={i} style={{ flex:1, flexDirection:'row', alignItems:'center', gap:12, padding:'12px 16px', background:'rgba(255,255,255,0.04)', borderRadius:10, border:'1px solid rgba(255,255,255,0.08)' }}>
            <Box style={{ width:34, height:34, borderRadius:17, background:'#2E5C8A', alignItems:'center', justifyContent:'center' }}>
              <Text style={{ fontSize:17, color:'#FFFFFF', fontWeight:'bold' }}>{r.n}</Text>
            </Box>
            <Box>
              <Text style={{ fontSize:16, color:'#E6EEF5', fontWeight:'bold' }}>{r.t}</Text>
              <Text style={{ fontSize:12.5, color:'#9FB6CC', lineHeight:1.4, marginTop:2 }}>{r.d}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:12, padding:'11px 18px', background:'rgba(46,92,138,0.20)', borderRadius:10, border:'1px solid rgba(46,92,138,0.55)' }}>
      <FAIcon name='shield' style={{ fill:'#22D3EE', width:20, height:20 }} />
      <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.5 }}>原则不变：任何阶段都保持<Text style={{ color:'#22D3EE', fontWeight:'bold' }}>只读</Text>——这是敢进车间的前提。</Text>
    </Box>
  </Box>
  <Box style={{ position:'absolute', bottom:0, left:0, right:0, height:44, flexDirection:'row', alignItems:'center', justifyContent:'space-between', paddingLeft:60, paddingRight:60, borderTop:'1px solid rgba(255,255,255,0.08)' }}>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>cncops-agent · 只读诊断</Text>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>13 / 15</Text>
  </Box>
</Slide>
