  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'row', gap:30 }}>
    <Box style={{ width:600, justifyContent:'center', alignItems:'center', background:'rgba(255,255,255,0.03)', borderRadius:14, border:'1px solid rgba(255,255,255,0.08)', padding:14 }}>
      <Image src='assets/report_card.png' style={{ width:'100%', height:520, objectFit:'contain', borderRadius:10 }} />
    </Box>
    <Box style={{ flex:1, flexDirection:'column', justifyContent:'center', gap:18 }}>
      <Text style={{ fontSize:22, color:'#E6EEF5', fontWeight:'bold' }}>车间平板能开的网页，戴手套也能点</Text>
      <Box style={{ flexDirection:'row', gap:12, alignItems:'flex-start' }}>
        <FAIcon name='arrow-right' style={{ fill:'#22D3EE', width:20, height:20, marginTop:4 }} />
        <Text style={{ fontSize:17, color:'#CDE6F5', lineHeight:1.55 }}>顶部状态条：一句话总览全厂（"3 台设备中 1 台报警"，报警整条变红）</Text>
      </Box>
