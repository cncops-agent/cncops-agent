<Slide style={{ width:'1280px', height:'720px', background:'#0F1B2D', padding:0, position:'relative' }}>
  <Box style={{ position:'absolute', top:0, left:0, right:0, height:6, background:'#22D3EE' }} />
  <Box style={{ position:'absolute', top:26, left:60, right:60, height:60, flexDirection:'row', alignItems:'center', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', alignItems:'baseline', gap:14 }}>
      <Text style={{ fontSize:13, color:'#22D3EE', fontWeight:'bold', letterSpacing:2 }}>PART 02</Text>
      <Text style={{ fontSize:30, color:'#E6EEF5', fontWeight:'bold' }}>核心诊断引擎（固定六步）</Text>
    </Box>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>ENGINE</Text>
  </Box>
  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'column', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:14 }}>
      <FAIcon name='cogs' style={{ fill:'#22D3EE', width:30, height:30 }} />
      <Text style={{ fontSize:24, color:'#E6EEF5', fontWeight:'bold' }}>固定六步，<Text style={{ color:'#22D3EE' }}>不用大模型也能跑</Text></Text>
      <Text style={{ fontSize:16, color:'#8FA3B8', marginLeft:'auto' }}>大模型是锦上添花，不是雪中送炭</Text>
    </Box>
    <Box style={{ flexDirection:'row', gap:10, alignItems:'stretch' }}>
      {[
        {n:'1', t:'口语解析', d:'设备别名 + 同义词，确定性匹配'},
        {n:'2', t:'取实时数据', d:'仿真器 / OPC-UA 只读接入'},
        {n:'3', t:'阈值比对', d:'报警码由阈值+回差+去抖推导'},
        {n:'4', t:'知识库检索', d:'字面+TF-IDF+结构化，Top-3'},
        {n:'5', t:'历史复发引用', d:'同故障主动提上次怎么处理'},
        {n:'6', t:'七段渲染', d:'结论/证据/原因/步骤/警告/来源/历史'},
      ].map((s, i) => (
        <Box key={i} style={{ flex:1, flexDirection:'column', alignItems:'center', padding:'18px 10px', background:'rgba(46,92,138,0.18)', borderRadius:12, border:'1px solid rgba(46,92,138,0.5)' }}>
          <Box style={{ width:46, height:46, borderRadius:23, background:'#22D3EE', alignItems:'center', justifyContent:'center', marginBottom:12 }}>
            <Text style={{ fontSize:24, color:'#0F1B2D', fontWeight:'bold' }}>{s.n}</Text>
          </Box>
          <Text style={{ fontSize:18, color:'#E6EEF5', fontWeight:'bold', textAlign:'center' }}>{s.t}</Text>
          <Text style={{ fontSize:12.5, color:'#9FB6CC', textAlign:'center', lineHeight:1.4, marginTop:6 }}>{s.d}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:12, padding:'12px 18px', background:'rgba(34,211,238,0.10)', borderRadius:10, border:'1px solid rgba(34,211,238,0.35)' }}>
      <FAIcon name='shield' style={{ fill:'#22D3EE', width:22, height:22 }} />
      <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.5 }}>大模型挂了，系统照样出完整报告——这正是我们敢说"安全"的底气。</Text>
    </Box>
  </Box>
  <Box style={{ position:'absolute', bottom:0, left:0, right:0, height:44, flexDirection:'row', alignItems:'center', justifyContent:'space-between', paddingLeft:60, paddingRight:60, borderTop:'1px solid rgba(255,255,255,0.08)' }}>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>cncops-agent · 只读诊断</Text>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>07 / 20</Text>
  </Box>
</Slide>
