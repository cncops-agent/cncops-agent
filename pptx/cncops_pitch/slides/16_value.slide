        <line x1='70' y1='210' x2='600' y2='210' stroke='#2E5C8A' strokeWidth='3' />
        <circle cx='100' cy='210' r='26' fill='#22D3EE' />
        <text x='100' y='218' style={{ fill:'#0F1B2D', fontSize:24, fontWeight:'bold', textAnchor:'middle' }}>1</text>
