        <text x='256' y='218' style={{ fill:'#FFFFFF', fontSize:24, fontWeight:'bold', textAnchor:'middle' }}>2</text>
        <circle cx='412' cy='210' r='26' fill='#27496D' />
        <text x='412' y='218' style={{ fill:'#FFFFFF', fontSize:24, fontWeight:'bold', textAnchor:'middle' }}>3</text>
        <circle cx='568' cy='210' r='26' fill='#16314F' />
        <text x='568' y='218' style={{ fill:'#FFFFFF', fontSize:24, fontWeight:'bold', textAnchor:'middle' }}>4</text>
        <text x='100' y='270' style={{ fill:'#22D3EE', fontSize:18, fontWeight:'bold', textAnchor:'middle' }}>仿真验证</text>
        <text x='100' y='296' style={{ fill:'#9FB6CC', fontSize:14, textAnchor:'middle' }}>已交付</text>
        <text x='256' y='270' style={{ fill:'#E6EEF5', fontSize:18, fontWeight:'bold', textAnchor:'middle' }}>只读网关</text>
