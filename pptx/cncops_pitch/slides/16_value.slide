  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'row', gap:34 }}>
    <Box style={{ width:660, justifyContent:'center' }}>
      <Text style={{ fontSize:18, color:'#9FB6CC', marginBottom:14 }}>落地路径（低风险渐进，任何阶段保持只读）：</Text>
