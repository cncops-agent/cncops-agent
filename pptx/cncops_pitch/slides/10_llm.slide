<Slide style={{ width:'1280px', height:'720px', background:'#0F1B2D', padding:0, position:'relative' }}>
  <Box style={{ position:'absolute', top:0, left:0, right:0, height:6, background:'#22D3EE' }} />
  <Box style={{ position:'absolute', top:26, left:60, right:60, height:60, flexDirection:'row', alignItems:'center', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', alignItems:'baseline', gap:14 }}>
      <Text style={{ fontSize:13, color:'#22D3EE', fontWeight:'bold', letterSpacing:2 }}>PART 02</Text>
      <Text style={{ fontSize:30, color:'#E6EEF5', fontWeight:'bold' }}>大模型增强与降级模式</Text>
    </Box>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>LLM</Text>
  </Box>
  <Box style={{ position:'absolute', top:104, left:60, right:60, bottom:50, flexDirection:'column', justifyContent:'space-between' }}>
    <Box style={{ flexDirection:'row', alignItems:'center', justifyContent:'center', gap:30, padding:'14px 18px', background:'rgba(34,211,238,0.10)', borderRadius:12, border:'1px solid rgba(34,211,238,0.35)' }}>
      <Text style={{ fontSize:20, color:'#CDE6F5' }}>真实 DeepSeek 验证：</Text>
      <Text style={{ fontSize:30, color:'#22D3EE', fontWeight:'bold' }}>20/20</Text>
      <Text style={{ fontSize:18, color:'#CDE6F5' }}>链路断言通过</Text>
      <Text style={{ fontSize:30, color:'#22D3EE', fontWeight:'bold' }}>11/11</Text>
      <Text style={{ fontSize:18, color:'#CDE6F5' }}>类故障被模型改写结论</Text>
    </Box>
    <Box style={{ flexDirection:'row', gap:24 }}>
      <Box style={{ flex:1, flexDirection:'column', padding:'22px 22px', background:'rgba(46,92,138,0.18)', borderRadius:14, border:'1px solid rgba(46,92,138,0.5)' }}>
        <Box style={{ flexDirection:'row', alignItems:'center', gap:12, marginBottom:12 }}>
          <FAIcon name='brain' style={{ fill:'#22D3EE', width:26, height:26 }} />
          <Text style={{ fontSize:22, color:'#E6EEF5', fontWeight:'bold' }}>增强模式（配了模型）</Text>
        </Box>
        <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.6 }}>· 只负责口语理解补充、原因排序与语言组织<Text style={{ color:'#22D3EE' }}>（narrative）</Text></Text>
        <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.6 }}>· 排查步骤<Text style={{ color:'#22D3EE', fontWeight:'bold' }}>恒取自知识库</Text>，模型不生成步骤</Text>
        <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.6 }}>· 结论更"会说人话"，证据与格式不变</Text>
      </Box>
      <Box style={{ flex:1, flexDirection:'column', padding:'22px 22px', background:'rgba(255,255,255,0.04)', borderRadius:14, border:'1px solid rgba(255,255,255,0.10)' }}>
        <Box style={{ flexDirection:'row', alignItems:'center', gap:12, marginBottom:12 }}>
          <FAIcon name='shield' style={{ fill:'#8FA3B8', width:26, height:26 }} />
          <Text style={{ fontSize:22, color:'#E6EEF5', fontWeight:'bold' }}>降级模式（无 Key）</Text>
        </Box>
        <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.6 }}>· 无 Key / 超时 8s / 校验失败 → 自动回退规则版</Text>
        <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.6 }}>· 七段格式<Text style={{ color:'#22D3EE', fontWeight:'bold' }}>完全不变</Text>，结论一样准</Text>
        <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.6 }}>· 断网可演示、离线可交付</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection:'row', alignItems:'center', gap:12 }}>
      <FAIcon name='check-circle' style={{ fill:'#22D3EE', width:22, height:22 }} />
      <Text style={{ fontSize:16, color:'#CDE6F5', lineHeight:1.5 }}>话术："配了模型，报告更会说人话；不配，结论一样准——这就是我们敢说安全的原因。"</Text>
    </Box>
  </Box>
  <Box style={{ position:'absolute', bottom:0, left:0, right:0, height:44, flexDirection:'row', alignItems:'center', justifyContent:'space-between', paddingLeft:60, paddingRight:60, borderTop:'1px solid rgba(255,255,255,0.08)' }}>
    <Text style={{ fontSize:13, color:'#8FA3B8' }}>cncops-agent · 只读诊断</Text>
