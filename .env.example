# ===== 复制本文件为 .env 后按需填写；本文件本身不含任何真实密钥 =====
# 说明：所有敏感信息只从这里（环境变量）进入程序，代码中不出现任何厂商名或密钥。

# ---- 数据源 ----
# simulator = 内置内存仿真数据源（离线可跑，默认）；opcua = 连接 OPC-UA 服务器
CNCOPS_DATA_SOURCE=simulator
CNCOPS_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840/cncops/
CNCOPS_OPCUA_TIMEOUT_SEC=3
# 采集周期（秒）
CNCOPS_SAMPLE_INTERVAL_SEC=2

# ---- 大模型（OpenAI 兼容协议，任意兼容该协议的厂商均可）----
# 留空 = 自动进入降级模式（关键词 + 阈值规则 + 知识库检索）
CNCOPS_LLM_API_BASE=
CNCOPS_LLM_API_KEY=
CNCOPS_LLM_MODEL=
CNCOPS_LLM_TIMEOUT_SEC=8
# 强制关闭大模型（0 = 关闭，1 = 强制开启用于自测）
CNCOPS_LLM_ENABLED=auto

# ---- 可选：向量嵌入（未配置则使用本地 TF-IDF 检索，无需联网）----
CNCOPS_EMBEDDING_API_BASE=
CNCOPS_EMBEDDING_API_KEY=
CNCOPS_EMBEDDING_MODEL=

# ---- 存储 ----
CNCOPS_DB_PATH=data/cncops.db
CNCOPS_KB_DIR=config/kb
CNCOPS_LOG_LEVEL=INFO
